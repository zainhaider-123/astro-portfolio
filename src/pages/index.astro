---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExplodedPortal from "../components/ExplodedPortal.astro";
import Assembly from "../components/Assembly.astro";
import Experience from "../components/Experience.astro";
import Stamp from "../components/Stamp.astro";
import { Icon } from "astro-icon/components";

const operator = {
  name: "Zain Haider",
  title: "Software Developer",
  strength: "Full-stack in Node.js and Python",
  location: "Karachi, Pakistan",
  email: "haiderzainy8@gmail.com",
  phone: "+923092273703",
  github: "https://github.com/zainhaider-123",
  discord: "https://discord.com/users/953699716045111338",
};

const skills = {
  languages: ["JavaScript", "Python", "HTML", "CSS", "Bash"],
  frontend: ["Next.js", "TanStack", "React", "Svelte", "Astro", "Django", "FastAPI"],
  backend: ["Express", "NestJS", "Hono", "Better Auth"],
  data: ["SQL", "PostgreSQL", "MongoDB"],
  tools: [
    "WordPress",
    "Git",
    "GitHub",
    "Supabase",
    "Firebase",
    "Vercel",
    "Typeform",
    "Figma",
    "Vercel AI SDK",
    "Railway",
    "Docker",
  ],
  other: ["AI agent skills", "CLI tooling", "webhooks", "job queues"],
};

const education = [
  {
    degree: "Masters of Engineering in Software Engineering",
    school: "NED University",
    span: "January 2026 — expected 2028",
  },
  {
    degree: "Bachelors of Engineering in Electronics Engineering",
    school: "NED University",
    span: "July 2021 — August 2025",
  },
];

const assemblies = [
  {
    name: "noia-ui",
    description: "Carousel UI library.",
    href: "https://github.com/zainhaider-123/noia-ui",
    technologies: ["JavaScript", "CSS", "HTML"],
    figure: "2",
  },
  {
    name: "tether-store",
    description:
      "Installs agent skills into a shared cache and symlinks the active set.",
    href: "https://github.com/zainhaider-123/tether-store",
    technologies: ["Go"],
    figure: "3",
  },
  {
    name: "qa-skill",
    description:
      "Compares a live site to a Figma frame. Scores pass / warning / severe.",
    href: "https://github.com/zainhaider-123/opencode-qa-skill",
    technologies: ["JavaScript", "Bash"],
    figure: "4",
  },
];

const experience = [
  {
    title: "Junior Full Stack Developer",
    company: "MayaBytes",
    duration: "September 2025 — Present",
    location: "Karachi, Pakistan",
  },
];

const resumeMailto = `mailto:${operator.email}?subject=${encodeURIComponent("Resume packet request")}`;
---

<BaseLayout title="Zain Haider — Operator Manual">
  <section class="section-block pt-8" aria-labelledby="operator-name">
    <div class="plate px-5 py-6 sm:px-8 sm:py-8">
      <div class="mt-0 grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <h1 id="operator-name">{operator.name}</h1>
          <p class="mt-4 font-display text-2xl sm:text-3xl font-bold uppercase tracking-wide">
            {operator.title}
          </p>
          <p class="mt-2 max-w-none">
            {operator.strength}. {operator.location}.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 lg:col-span-4 lg:justify-end">
          <Stamp href={resumeMailto}>
            <Icon name="download" size={14} class="mr-2 inline" />Request packet
          </Stamp>
          <Stamp href="#contact" ghost>Call in</Stamp>
        </div>
      </div>
    </div>

    <div class="mt-10 max-w-3xl">
      <ExplodedPortal />
    </div>
  </section>

  <section id="notes" class="section-block border-t border-ink">
    <h2>Notes</h2>
    <div class="spread mt-8 items-start">
      <div class="lg:col-span-7">
        <p>Node.js and Python. Karachi. Work is on GitHub.</p>
        <div class="mt-8 flex flex-wrap gap-5">
          <a
            href={operator.github}
            class="inline-flex items-center gap-2 nav-link"
            target="_blank"
            rel="noreferrer"
          >
            <Icon name="github" size={16} /> GitHub
          </a>
          <a
            href={operator.discord}
            class="nav-link"
            target="_blank"
            rel="noreferrer">Discord</a
          >
          <a href={`tel:${operator.phone}`} class="nav-link">Phone</a>
        </div>
      </div>
      <div class="lg:col-span-5 plate p-5">
        <p class="plate-label">Education</p>
        <ul class="mt-4 space-y-5">
          {
            education.map((item) => (
              <li>
                <p class="m-0 font-display text-xl font-bold uppercase leading-tight">
                  {item.degree}
                </p>
                <p class="mt-1 m-0">{item.school}</p>
                <p class="plate-label mt-1 m-0 text-cyan">{item.span}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12">
      <p class="plate-label">Parts</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          Object.values(skills)
            .flat()
            .filter((item, i, arr) => arr.indexOf(item) === i)
            .map((item) => (
              <li>
                <button type="button" class="part-chip">
                  {item}
                </button>
              </li>
            ))
        }
      </ul>
    </div>
  </section>

  <section id="assemblies" class="section-block border-t border-ink">
    <h2>Assemblies</h2>
    <div class="mt-4 space-y-4">
      {assemblies.map((item) => <Assembly {...item} />)}
    </div>
  </section>

  <section id="service" class="section-block border-t border-ink">
    <h2>Service log</h2>
    <div class="mt-6">
      {
        experience.map((item) => (
          <Experience
            title={item.title}
            company={item.company}
            duration={item.duration}
            location={item.location}
          />
        ))
      }
    </div>
  </section>

  <section id="contact" class="section-block border-t border-ink">
    <h2>Service call</h2>
    <div class="spread mt-8 items-start">
      <div class="lg:col-span-5">
        <p>Inbox. Ask for the packet in the message if you need it.</p>
        <ul class="mt-6 space-y-2">
          <li>
            <a class="underline" href={`mailto:${operator.email}`}>{operator.email}</a>
          </li>
          <li>
            <a class="underline" href={`tel:${operator.phone}`}>{operator.phone}</a>
          </li>
        </ul>
      </div>
      <form
        class="lg:col-span-7 plate p-5 sm:p-6 relative"
        action={`https://formsubmit.co/${operator.email}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Portfolio service call" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <label class="honey">
          Leave blank
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </label>
        <div class="grid gap-4">
          <label class="block">
            <span class="plate-label">Name</span>
            <input class="field mt-1" type="text" name="name" required />
          </label>
          <label class="block">
            <span class="plate-label">Return address</span>
            <input class="field mt-1" type="email" name="email" required />
          </label>
          <label class="block">
            <span class="plate-label">Message</span>
            <textarea class="field mt-1 min-h-32" name="message" required
            ></textarea>
          </label>
        </div>
        <div class="mt-6">
          <button type="submit" class="stamp">
            <span>Send to inbox</span>
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll(".part-chip").forEach((chip) => {
    chip.setAttribute("aria-pressed", "false");
    chip.addEventListener("click", () => {
      const inked = chip.classList.toggle("is-inked");
      chip.setAttribute("aria-pressed", String(inked));
    });
  });
</script>
