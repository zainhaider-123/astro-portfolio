---
import Image from "astro/components/Image.astro";
import Experience from "../components/Experience.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import LogoMarquee from "../components/LogoMarquee.astro";
import {
	intro,
	mySkill,
	aboutMeFeatured,
	featuredProjects,
	myExperience,
} from "../utils/content";

// todo: integrate staticform for contact form
---

<main>
	<BaseLayout title="Zain Haider">
		<!-- hero section -->
		<section class="hero-margin">
			<div class="container mx-auto px-5">
				<div
					class="grid md:grid-cols-2 grid-cols-1 md:gap-10 gap-5 items-center"
				>
					<div
						class="col-span-1 xl:space-y-8 lg:space-y-6 space-y-4 md:text-left text-center"
					>
						<h1 class="leading-[1.2em] capitalize">
							hello i'am
							<span class="font-bold">Zain Haider</span>
							<span class="font-bold">Full Stack</span>
							<span class="font-londrina font-bold">Developer</span>
						</h1>
						<p>{intro}</p>
						<div class="flex md:gap-5 gap-3 md:justify-start justify-center">
							<a
								href="https://linkedin.com/in/zain-haider110"
								target="_blank"
								class="xl:size-14 lg:size-12 size-10 border-2 rounded-lg flex shrink-0 justify-center items-center group hover:bg-foreground duration-150"
							>
								<Icon
									name="linkedin"
									class="group-hover:text-background duration-150 lg:size-6 size-4"
									title="Linked In"
								/>
							</a>
							<a
								href="https://github.com/zainhaider-123/"
								target="_blank"
								class="xl:size-14 lg:size-12 size-10 border-2 rounded-lg flex shrink-0 justify-center items-center group hover:bg-foreground duration-150"
							>
								<Icon
									name="github"
									class="group-hover:text-background duration-150 lg:size-6 size-4"
									title="GitHub"
								/>
							</a>
							<a
								href="https://discord.com/users/953699716045111338"
								target="_blank"
								class="xl:size-14 lg:size-12 size-10 border-2 rounded-lg flex shrink-0 justify-center items-center group hover:bg-foreground duration-150"
							>
								<Icon
									name="discord"
									class="group-hover:text-background duration-150 lg:size-6 size-4"
									title="Discord"
								/>
							</a>
						</div>
						<LogoMarquee logos={mySkill} />
					</div>
					<div class="col-span-1">
						<Image
							src="/profile.webp"
							alt="Zain Haider"
							width={646}
							height={862}
							loading="lazy"
							class="rounded-lg aspect-square w-full object-cover object-center"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- experience section -->
		<section class="sec-padding sec-margin bg-foreground">
			<div class="container mx-auto px-5">
				<h2 class="w-full text-center text-background">
					My <span class="font-bold">Experience</span>
				</h2>
				{
					myExperience.map((experience) => (
						<Experience
							class="2xl:mt-16 xl:mt-12 lg:mt-10 md:mt-8 mt-6"
							designation={experience.title}
							company={experience.company}
							duration={experience.duration}
							description={experience.description}
							variant="dark"
						/>
					))
				}
			</div>
		</section>

		<!-- about me section -->
		<section class="sec-margin">
			<div class="container mx-auto px-5">
				<div
					class="grid grid-cols-10 xl:gap-10 lg:gap-8 md:gap-6 gap-5 items-center text-center md:text-left"
				>
					<div class="md:col-span-4 col-span-10">
						<Image
							src="/zainHaider.webp"
							alt="Zain Haider"
							width={1024}
							height={1536}
							loading="lazy"
							class="rounded-lg w-full"
						/>
					</div>
					<div class="md:col-span-6 col-span-10 flex flex-col justify-center">
						<h2 class="capitalize">
							about <span class="font-bold">me</span>
						</h2>
						{
							aboutMeFeatured.map((paragraph) => (
								<p class="mt-5">{paragraph}</p>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- project section -->
		<section class="sec-padding sec-margin bg-foreground text-background">
			<div class="container mx-auto px-5">
				<h2 class="capitalize w-full text-center">
					featured <span class="font-bold">project</span>
				</h2>
				{
					featuredProjects.map((project, index) => (
						<article class="grid grid-cols-1 md:grid-cols-2 lg:gap-10 md:gap-8 gap-6 xl:mt-20 lg:mt-16 md:mt-12 mt-10 items-center text-center md:text-left">
							<div
								class={`col-span-1 ${index % 2 !== 0 ? "md:order-last 2xl:pl-20 xl:pl-14 lg:pl-10 md:pl-8 pl-0" : "2xl:pr-20 xl:pr-14 lg:pr-10 md:pr-8 pr-0"}`}
							>
								<a href={project.link}>
									<Image
										src={project.image}
										alt={project.name}
										width={400}
										height={400}
										loading="lazy"
										class="rounded-lg w-full aspect-video object-cover"
									/>
								</a>
							</div>
							<div class="col-span-1 flex flex-col justify-center lg:space-y-5 md:space-y-4 space-y-3">
								<h3 class="capitalize font-bold">{project.name}</h3>
								<p>{project.description}</p>
								<a
									href={project.link}
									class="inline-flex items-center space-x-2 w-fit group capitalize mx-auto md:mx-0"
								>
									<Icon
										name="external-link"
										class="group-hover:text-background/90 duration-150"
										size={17}
									/>
									<span class="group-hover:text-background/90 duration-150">
										learn more
									</span>
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>
	</BaseLayout>
</main>
