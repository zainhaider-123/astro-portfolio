---
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../utils/cn";

const buttonStyles = cva(
  "inline-flex items-center justify-center rounded-md lg:px-5 lg:py-3 px-4 py-2 font-medium duration-150 transition-colors",
  {
    variants: {
      variant: {
        primary: "bg-foreground text-background hover:bg-foreground/90",
        secondary: "bg-background text-foreground hover:bg-background/90",
      },
    },
    defaultVariants: {
      variant: "primary",
    },
  },
);

interface Props
  extends
    VariantProps<typeof buttonStyles>,
    astroHTML.JSX.ButtonHTMLAttributes {}

const { class: className, variant = "primary", ...props } = Astro.props;
---

<button class={cn(buttonStyles({ variant }), className)} {...props}>
  <slot />
</button>
