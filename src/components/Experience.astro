---
const { title, company, duration, location } = Astro.props;
---

<article class="border-t border-ink pt-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between">
    <div>
      <h3>{title}</h3>
      <p class="mt-1 font-label uppercase tracking-widest text-sm">{company}</p>
    </div>
    <p class="plate-label m-0 text-cyan">
      {duration}
      {location ? ` · ${location}` : ""}
    </p>
  </div>
</article>
