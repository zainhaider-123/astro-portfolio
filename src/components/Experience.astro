---
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../utils/cn";

const experienceStyles = cva(
  "w-full border rounded xl:py-14 lg:py-12 md:py-10 py-8 lg:px-8 md:px-6 px-4 lg:space-y-10 md:space-y-8 space-y-5",
  {
    variants: {
      variant: {
        light: "text-foreground border-foreground",
        dark: "text-background border-background",
      },
    },
    defaultVariants: {
      variant: "light",
    },
  },
);
const {
  class: className,
  designation,
  company,
  duration,
  description,
  variant,
} = Astro.props;
---

<article class={cn(experienceStyles({ variant }), className)}>
  <div class="flex justify-between flex-col sm:flex-row gap-5 items-center">
    <div class="sm:space-y-2 space-x-1 sm:text-left text-center">
      <h3>{designation}</h3>
      <h5>{company}</h5>
    </div>
    <h6 class="sm:text-left text-center">{duration}</h6>
  </div>
  <p class="sm:text-left text-center">{description}</p>
</article>
