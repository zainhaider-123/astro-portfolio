---
import { Icon } from "astro-icon/components";

const { name, description, href, technologies = [], figure } = Astro.props;
---

<details class="assembly border-t border-ink pt-8">
  <summary class="assembly-summary">
    <span class="plate-label text-cyan">FIG. {figure}</span>
    <h3 class="assembly-title">{name}</h3>
    <span class="plate-label assembly-hint">Inspect</span>
  </summary>
  <div class="assembly-body spread items-start mt-6">
    <div class="lg:col-span-5 drawing-board p-6">
      <div class="flex flex-col gap-2">
        {
          technologies.map((tech: string, i: number) => (
            <div class="probe-bay pointer-events-none">
              <span class="probe-bay-bar" />
              <span class="probe-bay-copy">
                <span class="probe-bay-label">{tech}</span>
              </span>
              <span class="balloon">{i + 1}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="lg:col-span-7">
      <p>{description}</p>
      <a
        href={href}
        class="mt-6 inline-flex items-center gap-2 font-label uppercase tracking-widest text-sm font-semibold"
        target="_blank"
        rel="noreferrer"
      >
        <Icon name="external-link" size={14} />
        Open repo
      </a>
    </div>
  </div>
</details>
