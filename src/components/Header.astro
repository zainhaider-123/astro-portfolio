---
import Stamp from "./Stamp.astro";
import Slide from "./Slide.astro";

const navLinks = [
  { name: "Notes", href: "#notes" },
  { name: "Assemblies", href: "#assemblies" },
  { name: "Service", href: "#service" },
  { name: "Call in", href: "#contact" },
];
---

<header class="running-head">
  <p class="plate-label m-0">ZH-SM · REV 01</p>
  <nav class="hidden md:block" aria-label="Primary">
    <ul class="flex items-center gap-7">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link">
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="md:hidden">
      <Slide id="header-mobile-nav" icon="menu" widthClass="w-80" buttonLabel="Menu">
        <nav aria-label="Mobile">
          <ul class="flex flex-col gap-5">
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="nav-link text-lg">
                    {link.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="mt-8">
            <Stamp href="#contact">Request packet</Stamp>
          </div>
        </nav>
      </Slide>
    </div>
</header>
